generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  MANUFACTURER
  ADMIN
}

enum RFQStatus {
  OPEN
  QUOTED
  ACCEPTED
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role      @default(BUYER)
  name          String
  avatar        String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company?
  rfqs          RFQ[]     @relation("BuyerRFQs")
  messages      Message[]

  @@map("users")
}

model Company {
  id            String    @id @default(cuid())
  userId        String    @unique
  name          String
  nameRu        String?
  nameUz        String?
  description   String?   @db.Text
  descriptionRu String?   @db.Text
  descriptionUz String?   @db.Text
  industry      String?
  region        String?
  city          String?
  website       String?
  logo          String?
  banner        String?
  documents     String[]
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  quotes      Quote[]
  rfqs        RFQ[]     @relation("CompanyRFQs")

  @@map("companies")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  nameRu        String?
  nameUz        String?
  description   String?  @db.Text
  descriptionRu String?  @db.Text
  descriptionUz String?  @db.Text
  categoryId    String?
  images      String[]
  minOrder    Int?
  unit        String?
  price       Float?
  specs       Json?
  exportReady Boolean  @default(false)
  hsCode      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
  rfqs        RFQ[]

  @@map("products")
}

model RFQ {
  id          String    @id @default(cuid())
  buyerId     String
  productId   String?
  companyId   String?
  title       String
  description String?   @db.Text
  quantity    Int?
  unit        String?
  budget      Float?
  deadline    DateTime?
  status      RFQStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  buyer       User      @relation("BuyerRFQs", fields: [buyerId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
  company     Company?  @relation("CompanyRFQs", fields: [companyId], references: [id])
  quotes      Quote[]
  messages    Message[]

  @@map("rfqs")
}

model Quote {
  id        String   @id @default(cuid())
  rfqId     String
  companyId String
  price     Float
  minOrder  Int?
  leadTime  String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  rfq       RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model Message {
  id        String   @id @default(cuid())
  rfqId     String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  rfq       RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sender    User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}
